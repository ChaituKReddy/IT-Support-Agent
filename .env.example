# ---------------------------------------------------------------------------
# LLM provider: "ollama" (local, default) or "anthropic" (cloud)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Ollama (local, no API key required) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-mlx

# --- Anthropic (only needed when LLM_PROVIDER=anthropic) -------------------
# Never commit a real key. Copy this file to .env and fill it in locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Generation settings ---------------------------------------------------
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# --- Application -----------------------------------------------------------
DB_PATH=data/it_support.db
SEED_DIR=data/seed
CHECKPOINT_DB_PATH=data/checkpoints.db
KB_SEARCH_TOP_K=3
DUPLICATE_TICKET_WINDOW_DAYS=7
MAX_AGENT_STEPS=6
LOG_LEVEL=INFO
